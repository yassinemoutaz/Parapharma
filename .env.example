# ============================================================
# ENVIRONMENT VARIABLES — EXAMPLE FILE
# ============================================================
# Copy this file to .env.local for local development and fill
# in real values. NEVER commit real secrets.
#
# Public variables (NEXT_PUBLIC_*) are embedded in the browser
# bundle. Everything else is server-only and must never be
# exposed to the browser.

# ------------------------------------------------------------
# Supabase (public — safe for the browser)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------
# R2 public delivery (public — safe for the browser)
# The public base URL used to build image URLs. Use the custom
# domain when configured (e.g. https://cdn.example.com),
# otherwise the r2.dev public URL of the bucket.
# ------------------------------------------------------------
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.example.com

# ------------------------------------------------------------
# Supabase (server-only secrets)
# The service role key bypasses RLS. Use ONLY in trusted
# server contexts (e.g. administrative operations). Never
# import it into client code.
# ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Cloudflare R2 (server-only secrets)
# S3-compatible API credentials scoped to the media bucket.
# ------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pharma-media